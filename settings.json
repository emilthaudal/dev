{
    "editor.suggestSelection": "first",
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go",
    },
    "git.autofetch": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.inlineSuggest.enabled": true,
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "github.copilot.enable": {
        "*": true,
        "yaml": true,
        "plaintext": true,
        "markdown": true,
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "workbench.startupEditor": "none",
    "go.toolsManagement.autoUpdate": true,
    "editor.fontFamily": "Monaspace Neon NF, Monaspace Neon, Menlo, Monaco",
    "editor.fontSize": 13,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off",
    },
    "security.workspace.trust.untrustedFiles": "open",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "editor.stickyScroll.enabled": true,
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "workbench.colorTheme": "Embark Theme",
    "workbench.iconTheme": "catppuccin-macchiato",
    "go.buildTags": "integration",
    "go.useLanguageServer": true,
    "gopls": {
        "ui.semanticTokens": true,
    },
    "redhat.telemetry.enabled": true,
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "go.inlayHints.assignVariableTypes": true,
    "github.copilot.advanced": {},
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always",
        "source.organizeImports": "always",
    },
    "prettier.endOfLine": "auto",
    "go.editorContextMenuCommands": {
        "fillStruct": true,
    },
    "workbench.preferredLightColorTheme": "Ayu Light",
    "material-icon-theme.activeIconPack": "react",
    "launch": {
        "configurations": [
            {
                "name": "Generic Launch Package",
                "type": "go",
                "request": "launch",
                "mode": "auto",
                "program": "${workspaceFolder}/cmd",
            },
        ],
        "compounds": [],
    },
    "projectManager.git.baseFolders": ["~/lunar"],
    "projectManager.tags": ["Personal", "Work", "Juno", "Paylike"],
    "editor.codeLensFontFamily": "Monaspace Neon NF, Monaspace Neon, Menlo, Monaco",
    "debug.console.fontSize": 14,
    "terminal.integrated.fontSize": 14,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "go.testEnvFile": "${workspaceFolder}/local.env",
    "go.buildFlags": ["-tags=integration"],
    "terminal.integrated.fontFamily": "Monaspace Neon NF, Monaspace Neon, Menlo, Monaco",
    "prettier.printWidth": 120,
    "prettier.tabWidth": 4,
    "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08'",
    "githubPullRequests.pushBranch": "always",
    "githubPullRequests.pullBranch": "never",
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggest.preview": true,
    "editor.suggest.shareSuggestSelections": true,
    "editor.suggest.showStatusBar": true,
    "typescript.preferences.importModuleSpecifier": "relative",
    "circleci.hostUrl": "",
    "workbench.fontAliasing": "auto",
    "githubPullRequests.terminalLinksHandler": "github",
    "githubPullRequests.notifications": "pullRequests",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "files.autoSave": "afterDelay",
    "githubPullRequests.fileListLayout": "tree",
    "circleci.notifications.mute": true,
    "github.copilot.nextEditSuggestions.enabled": false,
    "docker.extension.enableComposeLanguageServer": false,
    "yaml.customTags": [
        "!And",
        "!And sequence",
        "!If",
        "!If sequence",
        "!Not",
        "!Not sequence",
        "!Equals",
        "!Equals sequence",
        "!Or",
        "!Or sequence",
        "!FindInMap",
        "!FindInMap sequence",
        "!Base64",
        "!Join",
        "!Join sequence",
        "!Cidr",
        "!Ref",
        "!Sub",
        "!Sub sequence",
        "!GetAtt",
        "!GetAZs",
        "!ImportValue",
        "!ImportValue sequence",
        "!Select",
        "!Select sequence",
        "!Split",
        "!Split sequence",
    ],
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true,
        },
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "eslint.useFlatConfig": true,
    "chat.tools.terminal.autoApprove": {
        "yarn lint": true,
        "yarn upgrade-interactive": true,
        "yarn upgrade": true,
        "yarn test": true,
        "yarn workspace": true,
        "yarn tsc": true,
        "yarn run test": true,
        "yarn jest": true,
        "npm test": true,
        "yarn build:all": true,
        "npx": true,
        "yarn up": true,
        "yarn build": true,
        "yarn install": true,
    },
    "aws.cloudformation.telemetry.enabled": false,
    "githubPullRequests.defaultMergeMethod": "squash",
    "appmod.experimental.task.typescript.upgrade": true,
    "git.ignoreRebaseWarning": true,
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://opencode.ai": true,
        "https://models.dev": true,
    },
    "atlascode.jira.enabled": true,
    "atlascode.bitbucket.enabled": false,
    "atlascode.rovodev.showEntitlementNotifications": false,
    "aikido.coreUrl": "https://ide.aikido.dev",
}
