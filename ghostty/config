# Ghostty configuration
# Docs: https://ghostty.org/docs/config

# ── FONT ────────────────────────────────────────────────────────────────────
font-family = MapleMono NF
font-size = 13
font-feature = calt
font-feature = liga

# ── THEME ───────────────────────────────────────────────────────────────────
# Catppuccin Mocha — matches herdr theme
theme = catppuccin-mocha

# ── CURSOR ──────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── WINDOW ──────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 8
window-decoration = false

# ── SCROLLBACK ──────────────────────────────────────────────────────────────
scrollback-limit = 10000

# ── KEYBOARD ────────────────────────────────────────────────────────────────
# Send ESC sequences for Option key combinations (enables opt+backspace word
# delete, opt+left/right word navigation, etc.) instead of macOS special chars.
macos-option-as-alt = true

# ── MISC ────────────────────────────────────────────────────────────────────
# Copy on select
copy-on-select = clipboard

# Bold text uses bright colors
bold-is-bright = true

# Shell integration (provides better prompt/command tracking)
shell-integration = zsh
