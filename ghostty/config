# Ghostty configuration
# Docs: https://ghostty.org/docs/config

# ── FONT ────────────────────────────────────────────────────────────────────
font-family = Monaspace Argon NF
font-size = 13
font-feature = calt
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08

# ── THEME ───────────────────────────────────────────────────────────────────
# herdr and Claude Code take their colors from this theme
theme = Embark

# ── CURSOR ──────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── WINDOW ──────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# ── SCROLLBACK ──────────────────────────────────────────────────────────────
scrollback-limit = 10000

# ── KEYBOARD ────────────────────────────────────────────────────────────────
# opt+left/right word nav is a Ghostty default (alt+arrow_left/right=esc:b/f).
# opt+backspace has no default bind, so add it explicitly — this keeps Option
# free elsewhere for macOS dead-key/compose input (e.g. Danish opt+' -> @).
keybind = alt+backspace=text:\x1b\x7f

# ── MISC ────────────────────────────────────────────────────────────────────
# Copy on select
copy-on-select = clipboard

# Bold text uses bright colors
bold-is-bright = true

# Shell integration (provides better prompt/command tracking)
shell-integration = zsh
